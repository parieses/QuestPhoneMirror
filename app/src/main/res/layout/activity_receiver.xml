<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部手动连接栏：自动发现连上后隐藏，断开后恢复 -->
    <LinearLayout
        android:id="@+id/ipBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/hint_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/edtIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/receiver_ip_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_secondary"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/receiver_connect"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_secondary"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/receiver_refresh"
            android:textColor="#22D3EE"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 居中状态面板：搜索/连接/配对各阶段的引导都在这里，配对成功后隐藏 -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hint_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receiver_searching"
            android:textColor="#F1F5F9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStageHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/receiver_search_hint"
            android:textColor="#A5B4FC"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtPair"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/receiver_pair_hint"
            android:inputType="number"
            android:letterSpacing="0.3"
            android:maxLength="6"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="32sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_secondary"
            android:minWidth="0dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:text="@string/receiver_pair"
            android:textColor="#22D3EE"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部瞬时提示（错误/配对反馈） -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/hint_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- 剪贴板入口：输入/粘贴文本发送到手机剪贴板（Quest 等无输入法设备的刚需） -->
    <Button
        android:id="@+id/btnClipboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/btn_secondary"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/receiver_clipboard"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- 文件浏览入口：浏览/下载发送端文件 -->
    <Button
        android:id="@+id/btnFiles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/btn_secondary"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/receiver_files"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- 文件推送入口：选本机文件推送到发送端存储 -->
    <Button
        android:id="@+id/btnPush"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="136dp"
        android:background="@drawable/btn_secondary"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/receiver_push"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- 统计开关：开启后右上角显示投屏统计浮窗 -->
    <Button
        android:id="@+id/btnStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_secondary"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/receiver_stats"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- 投屏统计浮窗：半透明，默认隐藏 -->
    <TextView
        android:id="@+id/statsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#CC0B0A1F"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#22D3EE"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
