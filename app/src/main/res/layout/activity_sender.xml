<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题行：紧凑单行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="发送端"
                android:src="@drawable/ic_cast" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发送端"
                    android:textColor="#F1F5F9"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="本机作为被镜像的手机"
                    android:textColor="#A5B4FC"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 状态条：只承载状态事件，配对码统一由下方卡片展示（单点真源） -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="未开始投屏"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 主操作：置顶，文案随投屏状态切换 -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="开始投屏"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 配对码卡片：仅投屏中显示 -->
        <LinearLayout
            android:id="@+id/pairCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="配对码"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPairCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:text="------"
                android:textColor="#22D3EE"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="接收端输入此码后才能看画面并控制"
                android:textColor="#A5B4FC"
                android:textSize="12sp" />

            <!-- 无障碍未开启警告：条件显隐，点击跳系统设置 -->
            <TextView
                android:id="@+id/tvWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hint_bg"
                android:padding="12dp"
                android:text="控制权限未开启，对方只能看不能操作 · 点此开启"
                android:textColor="#FCD34D"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 投屏设置：画质 + 防息屏合并为一张卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="画质（接收端卡顿时选「流畅」）"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSmooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="流畅 4M"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbBalanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:checked="true"
                    android:text="均衡 6M"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="高清 10M"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#1E293B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="投屏期间防止自动息屏"
                        android:textColor="#E2E8F0"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="录屏在熄屏后会停，开启后投屏期间屏幕不会自动熄灭"
                        android:textColor="#A5B4FC"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swKeepAwake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 连接管理：多接收端时放行/踢人 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接管理"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="投屏中可扫描局域网接收端；取消勾选会立即断开该设备，对方会收到提示"
                android:textColor="#A5B4FC"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未扫描（接收端打开「我是接收端」后可扫描到）"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/llReceivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnScanReceivers"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="扫描接收端"
                android:textColor="#22D3EE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 文件共享：一次性授权 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文件共享"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="接收端点「文件」浏览本机存储所需，仅限共享存储根目录；不授权则文件功能不可用"
                android:textColor="#A5B4FC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilePerm"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="授予文件访问权限"
                android:textColor="#22D3EE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 底部提示：降级为一行小字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="投屏时请保持本 App 在前台，并在系统设置里允许其后台运行"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
