<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QPM" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/cyan</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <!-- 更新弹窗专用：windowBackground 透明，圆角深色卡片由布局自带背景绘制 -->
    <style name="Theme.QPM.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
